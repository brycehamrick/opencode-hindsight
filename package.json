{
  "name": "@brycehamrick/opencode-hindsight",
  "version": "0.2.1",
  "description": "Token-efficient long-term memory plugin for OpenCode",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brycehamrick/opencode-hindsight.git"
  },
  "keywords": [
    "opencode",
    "hindsight",
    "memory",
    "long-term-memory",
    "plugin",
    "ai"
  ],
  "author": "Bryce Hamrick",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@opencode-ai/plugin": "beta",
    "@types/node": "^22.0.0",
    "@vectorize-io/hindsight-client": "^0.5.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  }
}
